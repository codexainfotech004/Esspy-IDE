{
  "name": "espd-ide",
  "version": "1.0.0",
  "description": "ESPD IDE - Visual Block Coding for Arduino Uno / Nano / Mega",
  "main": "electron/main.js",
  "author": "Codexa",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.espd.ide",
    "productName": "ESPD IDE",
    "copyright": "Copyright © 2024 Codexa",
    "icon": "assets/icon.ico",
    "files": [
      "**/*",
      "!projects/**",
      "!*.md",
      "!.git/**",
      "!tests/**",
      "!**/*.test.js",
      "!dist/**",
      "!release/**"
    ],
    "asarUnpack": [
      "backend/**",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "backend/",
        "to": "backend/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ESPD IDE",
      "runAfterFinish": true,
      "installerLanguages": ["en_US"],
      "include": null
    },
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "compression": "normal"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.0"
  },
  "dependencies": {
    "blockly": "^13.0.0"
  }
}
